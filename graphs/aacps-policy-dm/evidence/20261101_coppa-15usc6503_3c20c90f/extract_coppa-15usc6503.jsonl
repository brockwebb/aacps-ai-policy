{"unit": "coppa-15usc6503#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "eb7400c8459dd7cc179fcd13743b17d1454aed34db2627a19897526e2833378f", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "An operator may satisfy the requirements of regulations issued under section 6502(b) of this title by following a set of self-regulatory guidelines, issued by representatives of the marketing or online industries, or by other persons, approved under subsection (b).", "span": {"start": 445, "end": 710, "sha256": "bac6055183d5e71f766da6bccd6dad13f14c7553626a59f2afcc41c00364b2b3", "parsed_sha256": "3c20c90f7ed59473ccc9d26e8789841822bba0d66eb524a334a29a35f56ed1e4"}, "matches_in_unit": 1, "section_path": "§6503. Safe harbors > (a) Guidelines", "page": null, "force": "permission", "binds": "An operator", "responsible_party_stated": true, "mechanism_stated": "approved under subsection (b)"}
{"unit": "coppa-15usc6503#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "eb7400c8459dd7cc179fcd13743b17d1454aed34db2627a19897526e2833378f", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "In prescribing regulations under section 6502 of this title, the Commission shall provide incentives for self-regulation by operators to implement the protections afforded children under the regulatory requirements described in subsection (b) of that section.", "span": {"start": 770, "end": 1029, "sha256": "292247b3d9771c62fbf568f6553b63f7ad62b030c5038e2812174aa6bca79f35", "parsed_sha256": "3c20c90f7ed59473ccc9d26e8789841822bba0d66eb524a334a29a35f56ed1e4"}, "matches_in_unit": 1, "section_path": "§6503. Safe harbors > (1) Self-regulatory incentives", "page": null, "force": "obligation", "binds": "the Commission", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "coppa-15usc6503#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "eb7400c8459dd7cc179fcd13743b17d1454aed34db2627a19897526e2833378f", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Such incentives shall include provisions for ensuring that a person will be deemed to be in compliance with the requirements of the regulations under section 6502 of this title if that person complies with guidelines that, after notice and comment, are approved by the Commission upon making a determination that the guidelines meet the requirements of the regulations issued under section 6502 of this title.", "span": {"start": 1059, "end": 1468, "sha256": "facb4ac74f9f7e01b927545efda5ce32b1cb1c99369dddf6c17b925c57541677", "parsed_sha256": "3c20c90f7ed59473ccc9d26e8789841822bba0d66eb524a334a29a35f56ed1e4"}, "matches_in_unit": 1, "section_path": "§6503. Safe harbors > (2) Deemed compliance", "page": null, "force": "obligation", "binds": "Such incentives", "responsible_party_stated": false, "mechanism_stated": "after notice and comment, are approved by the Commission upon making a determination"}
{"unit": "coppa-15usc6503#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "eb7400c8459dd7cc179fcd13743b17d1454aed34db2627a19897526e2833378f", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The Commission shall act upon requests for safe harbor treatment within 180 days of the filing of the request, and shall set forth in writing its conclusions with regard to such requests.", "span": {"start": 1511, "end": 1698, "sha256": "d03258ca163a8351de8e9f1e5e31225f594b0f621d9fbfdb5338ebbf3266d78c", "parsed_sha256": "3c20c90f7ed59473ccc9d26e8789841822bba0d66eb524a334a29a35f56ed1e4"}, "matches_in_unit": 1, "section_path": "§6503. Safe harbors > (3) Expedited response to requests", "page": null, "force": "obligation", "binds": "The Commission", "responsible_party_stated": true, "mechanism_stated": "within 180 days of the filing of the request"}
{"unit": "coppa-15usc6503#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "eb7400c8459dd7cc179fcd13743b17d1454aed34db2627a19897526e2833378f", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Final action by the Commission on a request for approval of guidelines, or the failure to act within 180 days on a request for approval of guidelines, submitted under subsection (b) may be appealed to a district court of the United States of appropriate jurisdiction as provided for in section 706 of title 5.", "span": {"start": 1718, "end": 2027, "sha256": "f82668121b9edb34fc0b5576b589ca45881acfff9978b77eeb996005d627b62e", "parsed_sha256": "3c20c90f7ed59473ccc9d26e8789841822bba0d66eb524a334a29a35f56ed1e4"}, "matches_in_unit": 1, "section_path": "§6503. Safe harbors > (c) Appeals", "page": null, "force": "permission", "binds": null, "responsible_party_stated": false, "mechanism_stated": "appealed to a district court of the United States of appropriate jurisdiction as provided for in section 706 of title 5"}
