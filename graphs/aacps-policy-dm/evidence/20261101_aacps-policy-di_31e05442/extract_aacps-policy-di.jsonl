{"unit": "aacps-policy-di#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "67622e67726b6f8f5113ef8ffedb89f5c5f7a951e9cc056384b1927756f385ee", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "This policy shall govern the use of all technological equipment, software, hardware, and related materials, electronic devices, and network systems.", "span": {"start": 172, "end": 320, "sha256": "65c55c4ef515b5bf64a3ca53a90a61fe9907b0682fe18fa79457981ebd7cb6a0", "parsed_sha256": "a74d58c325f2b9cd1228afd2137761d059ba74568bdb4050af15a21284edd4b5"}, "matches_in_unit": 1, "section_path": "A. PURPOSE", "page": 1, "force": "obligation", "binds": "This policy", "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "aacps-policy-di#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "67622e67726b6f8f5113ef8ffedb89f5c5f7a951e9cc056384b1927756f385ee", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Using technological resources for purposes other than those for which they were intended is prohibited.", "span": {"start": 640, "end": 743, "sha256": "3a7ef6519b5bfeda5dfa8315f4e45919201e3285c6bd1083bf54f7abc8fecb78", "parsed_sha256": "a74d58c325f2b9cd1228afd2137761d059ba74568bdb4050af15a21284edd4b5"}, "matches_in_unit": 1, "section_path": "C. POSITION", "page": 1, "force": "prohibition", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "aacps-policy-di#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "67622e67726b6f8f5113ef8ffedb89f5c5f7a951e9cc056384b1927756f385ee", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Responsibility for ethical behavior rests with all individuals who use AACPS technological resources.", "span": {"start": 987, "end": 1088, "sha256": "5b11aa592893b224eab4c3cd1f9ecca70b700f904827dcb4aca493fa0b5bd25d", "parsed_sha256": "a74d58c325f2b9cd1228afd2137761d059ba74568bdb4050af15a21284edd4b5"}, "matches_in_unit": 1, "section_path": "C. POSITION", "page": 1, "force": "obligation", "binds": "all individuals who use AACPS technological resources", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-di#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "67622e67726b6f8f5113ef8ffedb89f5c5f7a951e9cc056384b1927756f385ee", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS retains the right to monitor file server space and review materials on user accounts when a legitimate business need exists or as otherwise necessary to promote the interests of AACPS.", "span": {"start": 1209, "end": 1399, "sha256": "9527b7f75a88bb55fc8804b76cd7367c65e25086b6091efc2bb8243974c5fe1e", "parsed_sha256": "a74d58c325f2b9cd1228afd2137761d059ba74568bdb4050af15a21284edd4b5"}, "matches_in_unit": 1, "section_path": "C. POSITION", "page": 1, "force": "permission", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": "when a legitimate business need exists"}
