{"unit": "aacps-policy-dl#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "cdc0b3f18a51a79e907e397ef8a7fb856b66193420fdcbd47ff5ec392e1ebc92", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "It is the responsibility of AACPS to ensure that legal measures are taken and best practices followed to protect personally identifiable information of employees and students across AACPS information technology and records management systems.", "span": {"start": 445, "end": 687, "sha256": "3b345dc97cc3572901f5ed9b9c4ea68ae007d15afe17d48b7050a7b4f1795eed", "parsed_sha256": "c96cd1489bc12cf0223cd77fe808f1b8663086ac1a3ddbf5ea65f0c4d34fcd47"}, "matches_in_unit": 1, "section_path": "B. ISSUE", "page": 1, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-dl#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "cdc0b3f18a51a79e907e397ef8a7fb856b66193420fdcbd47ff5ec392e1ebc92", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Further, the Family Educational Rights and Privacy Act generally prohibits the disclosure by schools that receive federal education funding of personally identifiable information from a student's education records unless an exception applies.", "span": {"start": 688, "end": 930, "sha256": "715a1b4a6bb57eef284387b8d56573743e175f4a7b86e9dded02880ac74cd82e", "parsed_sha256": "c96cd1489bc12cf0223cd77fe808f1b8663086ac1a3ddbf5ea65f0c4d34fcd47"}, "matches_in_unit": 1, "section_path": "B. ISSUE", "page": 1, "force": "prohibition", "binds": "schools that receive federal education funding", "responsible_party_stated": true, "mechanism_stated": "unless an exception applies"}
{"unit": "aacps-policy-dl#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "cdc0b3f18a51a79e907e397ef8a7fb856b66193420fdcbd47ff5ec392e1ebc92", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall maintain reasonable storage and security procedures and best practices in place to protect AACPS data.", "span": {"start": 1221, "end": 1335, "sha256": "7f4e9271d98af660af4a083f86b8273863b966f6e8b40b3534c64d3673e9ef0e", "parsed_sha256": "c96cd1489bc12cf0223cd77fe808f1b8663086ac1a3ddbf5ea65f0c4d34fcd47"}, "matches_in_unit": 1, "section_path": "C. POSITION", "page": 1, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-dl#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "cdc0b3f18a51a79e907e397ef8a7fb856b66193420fdcbd47ff5ec392e1ebc92", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The Superintendent is authorized to develop regulations to implement this policy.", "span": {"start": 1856, "end": 1937, "sha256": "47712e1fc83798c00a0ad54e3e7e2433f53b0e4ba2d01e7c3c53795a35689648", "parsed_sha256": "c96cd1489bc12cf0223cd77fe808f1b8663086ac1a3ddbf5ea65f0c4d34fcd47"}, "matches_in_unit": 1, "section_path": "D. IMPLEMENTATION", "page": 2, "force": "permission", "binds": "The Superintendent", "responsible_party_stated": true, "mechanism_stated": null}
