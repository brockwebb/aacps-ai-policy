{"unit": "msde-it-guidance#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "a2fed095690c2930c00a604aefeb5299662e91b8858a71cad15054782822d664", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Begin with low-risk applications like administrative task automation rather than student-facing systems.", "span": {"start": 3901, "end": 4005, "sha256": "a07939d760b7566d8fd77ae1327b5fa85a813354e21f597878a63c8783479c47", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "START SMALL AND SCALE THOUGHTFULLY", "page": 2, "force": "recommendation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
