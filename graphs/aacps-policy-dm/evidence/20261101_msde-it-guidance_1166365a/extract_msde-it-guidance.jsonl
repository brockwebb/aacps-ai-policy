{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Focus on clear operational or educational benefits rather than implementing AI for its own sake.", "span": {"start": 810, "end": 906, "sha256": "41d46d66a007e2bdf35bdd3d3c494f3a18c207d29254bcd906202a8c8416e9ef", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "CRITICAL QUESTIONS TO ASK", "page": 1, "force": "recommendation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Any AI system handling student information requires additional privacy protections and compliance considerations.", "span": {"start": 938, "end": 1051, "sha256": "d3f1a77fc133e3ae844d8f8879bd22665d3a08634c303a785525fb80bc2507f4", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "CRITICAL QUESTIONS TO ASK", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Special education records, health information, disciplinary data, and family financial information all require enhanced safeguards when processed by AI.", "span": {"start": 1295, "end": 1447, "sha256": "86e4c1a70ee8e6698e524cbc1ae8e6563dd90232ecc2fdd6a59c26de96db0551", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "CRITICAL QUESTIONS TO ASK", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Data sharing agreements must specifically address AI use", "span": {"start": 1775, "end": 1831, "sha256": "b6f5ddd2f70575e5983648719a7e5163f565dd59e9c4c739be8f8016594202d1", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "STUDENT DATA PROTECTION REQUIREMENTS", "page": 1, "force": "obligation", "binds": "Data sharing agreements", "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Always read the actual terms, not just marketing materials.", "span": {"start": 2052, "end": 2111, "sha256": "ffc67b0fa5680424db19413295f6d309b59fdf7fe21b4a8dd5c6e0281b0a3f1f", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "CRITICAL IMPLEMENTATION WARNINGS", "page": 1, "force": "recommendation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Consider long-term sustainability before committing to proprietary AI systems.", "span": {"start": 2205, "end": 2283, "sha256": "ea8f939d6b735e035171613db29dc3240ad73a758e5258e4ada84b787382137e", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "CRITICAL IMPLEMENTATION WARNINGS", "page": 1, "force": "recommendation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Avoid becoming dependent on systems you cannot control.", "span": {"start": 2378, "end": 2433, "sha256": "38cbea1caa5a7a0b181930b95d73ef714d092305d055791057ccb5f5d6ec5d82", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "CRITICAL IMPLEMENTATION WARNINGS", "page": 1, "force": "recommendation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Deploy staff training before implementing AI systems.", "span": {"start": 2464, "end": 2517, "sha256": "2428706d74e08cb0e94cc61dcab79c77f6a8fff819d2e076d9552f1d512faed0", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "CRITICAL IMPLEMENTATION WARNINGS", "page": 2, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": "before implementing AI systems"}
{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Staff need to understand both capabilities and limitations, including accuracy issues and bias potential, before using AI tools with students or families.", "span": {"start": 2518, "end": 2672, "sha256": "60c77769f85cc6a2c99a99465bef5c6abf459dd3e10224820be043d8bfd63506", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "CRITICAL IMPLEMENTATION WARNINGS", "page": 2, "force": "obligation", "binds": "Staff", "responsible_party_stated": true, "mechanism_stated": "before using AI tools with students or families"}
{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Require human oversight for all AI outputs that affect students or families.", "span": {"start": 2911, "end": 2987, "sha256": "c64a57ffc3204e132dbeb64cf1230dcf13d8a6d876376e2d719873286122bb17", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "BIAS AND ACCURACY CONCERNS", "page": 2, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": "human oversight"}
{"unit": "msde-it-guidance#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3c51ed2670255110d4f19609d1b88006999da8020d417b72152d02b11f7ca89c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "LEAs should consider prohibiting AI use for:\n\nAutomated decisions affecting individual students (disciplinary actions, special education placement, etc.)", "span": {"start": 3018, "end": 3171, "sha256": "bba633522264b6ff3f37f3d1237209438bf9ee396036056e5679004e5aa9de86", "parsed_sha256": "e87423d5cc3c93d38c1c324d2fecb1dedace1d445ee781ea3db6c7718adacece"}, "matches_in_unit": 1, "section_path": "PROHIBITED USES TO CONSIDER", "page": 2, "force": "recommendation", "binds": "LEAs", "responsible_party_stated": true, "mechanism_stated": null}
