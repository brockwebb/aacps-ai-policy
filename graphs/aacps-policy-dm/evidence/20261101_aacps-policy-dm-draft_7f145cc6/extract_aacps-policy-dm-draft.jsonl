{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AI shall be used in accordance with federal and State laws, Board of Education of Anne Arundel County (Board) policies and administrative regulations, and the AACPS Strategic Plan.", "span": {"start": 473, "end": 653, "sha256": "90aea149b411a6f3a0c97478dce43b3be822c6f96c22f488362f1e2749e90e64", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "reference", "text": "AACPS Strategic Plan", "span": {"start": 632, "end": 652, "sha256": "c02577a0ddcc6f410d8dd9d0ab77d3853c2b2616a31caba2c757a3bad330a4e1", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE", "page": 1, "target": "ref:aacps_strategic_plan", "target_kind": "external", "cited_instrument": "AACPS Strategic Plan"}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AI shall be used in ways that enhance, and never replace, the professional judgment of employees.", "span": {"start": 1298, "end": 1395, "sha256": "b0fa3aa64c21cd2bd829f5e1dbde293ffd5343f1a0adfb7012d4983cd21368fd", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AI used by AACPS shall serve a clear educational or operational purpose; protect the rights and safety of students, employees, parents/guardians, and other stakeholders; and comply with applicable federal and State laws and Board polices and AACPS administrative regulations.", "span": {"start": 1503, "end": 1778, "sha256": "3b5ad6e8144d6f9400f6727ce6c3cd5a30471b77499b8a5095d96a3553f62538", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE", "page": 1, "force": "obligation", "binds": "AI used by AACPS", "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AI shall support, and may not replace, the professional expertise and responsibilities of employees and stakeholders.", "span": {"start": 1796, "end": 1913, "sha256": "558af6f4c9638d1c406b261306c495441695935215e0c68bbf952f399c66160f", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Any AI output used in a consequential decision affecting a student or employee shall be subject to documented human oversight.", "span": {"start": 1915, "end": 2041, "sha256": "1499ade4f795f6681b3dff5038efb0e6dbcd19c8fe8a1151ee2fa2ffec107bbe", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": "documented human oversight"}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Employees and stakeholders retain the authority and responsibility to interpret, contextualize, override, or reject AI outputs.", "span": {"start": 2042, "end": 2169, "sha256": "efaa562c033405d5da554c949f2856f9a6686272fa0cd0501eaf9fc5d7d5ffa0", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE", "page": 1, "force": "permission", "binds": "Employees and stakeholders", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AI may only be used for approved administrative, educational, and operational purposes in AACPS.", "span": {"start": 2235, "end": 2331, "sha256": "35096dd7871d2565b32afe707704da77cb7d8b6b5efdbd6399758e8f45344c75", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "DM - RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE Page 2 of 2", "page": 2, "force": "prohibition", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AI shall be used to expand equitable access to opportunity.", "span": {"start": 2336, "end": 2395, "sha256": "75bb4babbfdd8e2feb92825e341c541bc1e201ebbd39b7c7b0c7bf87d1355f14", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "DM - RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE Page 2 of 2", "page": 2, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall monitor AI tools for biased, discrimination, or inequitable outcomes and take corrective action where disparities emerge.", "span": {"start": 2397, "end": 2530, "sha256": "5aefc0ead3f235131e3ec3be868f2b1be4d8e23e1d3f60a738196bccce618d68", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "DM - RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE Page 2 of 2", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall establish expectations, conditions, and limitations for student use of AI.", "span": {"start": 2535, "end": 2621, "sha256": "9c7c72e58ee7cbfcae6d932241b95ea52808b5a62bcc33094fbe7b5954344a47", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "DM - RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE Page 2 of 2", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall provide role-specific professional learning so that employees can use AI safely, ethically, and effectively.", "span": {"start": 2626, "end": 2746, "sha256": "aebeb90417f1fdf6bae77c06a7ec921ba047cb1c74ab8f62d08225a2b1f34b13", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "DM - RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE Page 2 of 2", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Professional learning shall emphasize critical evaluation of AI outputs, protection of student data, and recognition of when AI use is inappropriate.", "span": {"start": 2748, "end": 2897, "sha256": "7328389c2fbcb6675b32ad47fc38af395fbcc9f9b516c2607f7f01e143d83ab1", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "DM - RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE Page 2 of 2", "page": 2, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AI tools shall be vetted before adoption for educational value, data practices, accessibility, and compliance with applicable federal and State laws and Board policies and administrative regulations.", "span": {"start": 2902, "end": 3101, "sha256": "2a88b1ab4c2ae7131f690046f965151a3f9b35786733429bf8f706e281406caa", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "DM - RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE Page 2 of 2", "page": 2, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": "vetted before adoption"}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall communicate with students, parents/guardians, employees, and other stakeholders the AI tools used, data collection and retention practices, and when optout options apply.", "span": {"start": 3106, "end": 3288, "sha256": "2a9ba6ef840032a2f50567e10b5841cc5eb59c9ae37ddb9fb80a6fc0fdaf2a96", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "DM - RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE Page 2 of 2", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-dm-draft#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b387097d22c0dd1dd24e449cd7a07e2129837159de277331b86739d2eca2f71c", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The Superintendent is authorized to develop regulations to implement this policy.", "span": {"start": 3309, "end": 3390, "sha256": "47712e1fc83798c00a0ad54e3e7e2433f53b0e4ba2d01e7c3c53795a35689648", "parsed_sha256": "6676279279bb50a2e58d5d69244acaf7e1c382c811eb063c171398fb056d61d7"}, "matches_in_unit": 1, "section_path": "DM - RESPONSIBLE USE OF ARTIFICIAL INTELLIGENCE Page 2 of 2", "page": 2, "force": "permission", "binds": "The Superintendent", "responsible_party_stated": true, "mechanism_stated": null}
