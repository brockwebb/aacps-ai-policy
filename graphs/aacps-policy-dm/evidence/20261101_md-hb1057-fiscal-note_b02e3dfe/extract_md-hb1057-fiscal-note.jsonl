{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "This  bill  requires  the  Maryland  State  Department  of  Education  (MSDE)  to  provide guidance on artificial intelligence (AI) to local school systems, educators, parents, and students through an online platform.", "span": {"start": 188, "end": 405, "sha256": "ff11ce805e3bedfa2164c1a2453c2ec361d1816ea10f04978e40e31267ebae86", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Education - Artificial Intelligence - Guidelines, Professional Development, and Collaborative (Artificial Intelligence Ready Schools Act)", "page": 1, "force": "obligation", "binds": "the Maryland State Department of Education (MSDE)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Local school systems must adopt an AI policy aligned with the guidance within 120 days of its release, designate an AI coordinator, and procure AI tools consistent with specified requirements adopted by the Department of Information Technology (DoIT).", "span": {"start": 406, "end": 657, "sha256": "bdb76bc736c2c39c240438bfb45f8052e2b93f64c5bdeeb31f7af9d38ff0b9e5", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Education - Artificial Intelligence - Guidelines, Professional Development, and Collaborative (Artificial Intelligence Ready Schools Act)", "page": 1, "force": "obligation", "binds": "Local school systems", "responsible_party_stated": true, "mechanism_stated": "within 120 days of its release"}
{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "MSDE must also (1) develop and publish a rubric and other evaluative tools to assist local school systems in the evaluation of AI tools selected for use by the local school  system", "span": {"start": 658, "end": 838, "sha256": "e7fe037dd7c63cbb8f5e2b592db84079d272e292475c7f81f1a8ffc61cc11f4f", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Education - Artificial Intelligence - Guidelines, Professional Development, and Collaborative (Artificial Intelligence Ready Schools Act)", "page": 1, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "incorporate  AI  literacy  into  workforce  preparation  standards  and computer science standards for kindergarten through grade 12 by June 1, 2027", "span": {"start": 846, "end": 994, "sha256": "dfebdcdbbbfabf3480a078f645aeebf4668bce48e049b4ac70536279f20d640c", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Education - Artificial Intelligence - Guidelines, Professional Development, and Collaborative (Artificial Intelligence Ready Schools Act)", "page": 1, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": "by June 1, 2027"}
{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "provide professional development in AI to educators and school leaders", "span": {"start": 1000, "end": 1070, "sha256": "dbf337bbe1fb1e97a904e60cce02adbd8485677d37593310e735fec34923e2ae", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Education - Artificial Intelligence - Guidelines, Professional Development, and Collaborative (Artificial Intelligence Ready Schools Act)", "page": 1, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "staff and support the new Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "span": {"start": 1080, "end": 1186, "sha256": "ce0b986a57fde3579fbaaf2cb0efd124af88268a7fa076433ef2408fd0834b3b", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Education - Artificial Intelligence - Guidelines, Professional Development, and Collaborative (Artificial Intelligence Ready Schools Act)", "page": 1, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "which  must  issue specified reports  and  recommendations", "span": {"start": 1188, "end": 1246, "sha256": "aaa8ce2937f0361513841c132238740a0225dc44ea51c71ab64b207318d85d6c", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Education - Artificial Intelligence - Guidelines, Professional Development, and Collaborative (Artificial Intelligence Ready Schools Act)", "page": 1, "force": "obligation", "binds": "the Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "MSDE must provide  guidance  on  AI  to  local  school  systems,  educators,  parents,  and students through an online platform", "span": {"start": 2631, "end": 2758, "sha256": "984dc5718b8f0b44385886fee4827f88f175bf62522dc82917956d4c8794038b", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "AI Guidance", "page": 2, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "MSDE, in consultation with other interested stakeholders, must publish separate guidance on its website for students, educators, administrators, and parents and guardians.", "span": {"start": 3194, "end": 3365, "sha256": "3028ccc0fa01add2c01c196d9edcb154dbf11eb9fbf4a8c496444bc9862cabf8", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "AI Guidance", "page": 2, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": "in consultation with other interested stakeholders"}
{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "MSDE must annually review and update the guidance as necessary.", "span": {"start": 3366, "end": 3429, "sha256": "ff79bc533929014db240a282d674600281dcfc54d7825cb41aca1d214beb3d9d", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "AI Guidance", "page": 2, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": "annually"}
{"unit": "md-hb1057-fiscal-note#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "872cdd375938fe26cf0d77c3f25e1d58a3837b2bd500785688b16b0bcd61b9d9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "MSDE must also develop strategies to assist local boards of education and county superintendents to implement the guidelines and best practices.", "span": {"start": 3430, "end": 3574, "sha256": "57b9d8c135057944c1fb27c5e6bdd0d09e1c297c810c78d8736758c42417cbf1", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "AI Guidance", "page": 2, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "MSDE must develop and publish a rubric and other evaluative tools, as necessary, to assist local  school  systems  in  the  evaluation  of  AI  tools  selected  for  use  by  the  local  school system.", "span": {"start": 3608, "end": 3809, "sha256": "0cd9465c2f1dbb9662304554e379a1782e0403c35825a99550ca498a0890cde5", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "AI Rubric and Evaluative Tools", "page": 2, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The  rubric  must  be  designed  to  support  local  school  systems  in  determining whether AI tools are consistent with State guidelines.", "span": {"start": 3811, "end": 3951, "sha256": "06231f23e54ff98e6d734ae19557be17db126b8750971494c45bd3d31505f135", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "AI Rubric and Evaluative Tools", "page": 2, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "MSDE periodically may review and update the rubric as necessary to reflect changes in technology, law, or State policy.", "span": {"start": 3952, "end": 4071, "sha256": "26e0bdd06e16545e49fabf9c95a66405fa3dbe231561186539641f0cd79360f8", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "AI Rubric and Evaluative Tools", "page": 2, "force": "permission", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "On request, Morgan State University or another four-year institution of higher education in the State may support local school systems in assessing the tools against the rubric.", "span": {"start": 4072, "end": 4249, "sha256": "1256bb4ac1fa9250c32c0f739e8bd0b102f91b3d5ed1d06d8ff5684a910ca45c", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "AI Rubric and Evaluative Tools", "page": 2, "force": "permission", "binds": "Morgan State University or another four-year institution of higher education in the State", "responsible_party_stated": true, "mechanism_stated": "On request"}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The AI coordinator designated by each local school system must be employed at the central office administration level as noninstructional staff and serve as liaison between the local school system and the State on the productive and ethical use of systems of AI in the local school system.", "span": {"start": 4346, "end": 4635, "sha256": "1c066d309167015cdf49826b7d629acff7464e274c67a44e564cdbd90e5af9a1", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Local School System Artificial Intelligence Policies, Coordinators, and Procurement", "page": 3, "force": "obligation", "binds": "The AI coordinator designated by each local school system", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Each local  school  system  must  use  the  rubric  and  other  evaluative  tools  developed  by MSDE in the review and selection of AI tools for use within the local school system.", "span": {"start": 4637, "end": 4818, "sha256": "78cff87a8765d317416b1b9ebc37afed8c2be7373efb7fed979b555a6d6eead9", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Local School System Artificial Intelligence Policies, Coordinators, and Procurement", "page": 3, "force": "obligation", "binds": "Each local  school  system", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "MSDE must provide professional development in AI to educators and school leaders that (1)  is  sufficient  in  duration  and  quality  to  prepare  educators  and  school  leaders  to professionally use AI, apply AI to instruction, and understand ethical considerations of AI and  (2)  provides  substantial  coverage  of  specified  topics  relating  to  the  function  and effective use of AI in classrooms.", "span": {"start": 4879, "end": 5288, "sha256": "bd0ee73909023a18040dac106ee6750bc4d30661d12cb2370bdc58b150e5cd3f", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Workforce Preparation - Professional Development Training", "page": 3, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Professional development must be provided either during the employee's regular workday as part of time designated for professional development or as a course that is eligible for credit toward licensure renewal.", "span": {"start": 5289, "end": 5500, "sha256": "6165eed7ece9415783a9c758e9fc3b59215269f22819ccf804709d2083e8b35d", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Workforce Preparation - Professional Development Training", "page": 3, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "MSDE must provide  staff  for  the  collaborative", "span": {"start": 6115, "end": 6164, "sha256": "9e008255297b09f4b673267e774d8bfeeb7b98d40e258b6da6f8d2ab1e638943", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "page": 3, "force": "obligation", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "may  partner  or  contract  with  an  organization  to support the collaborative", "span": {"start": 6171, "end": 6251, "sha256": "48c0166b68847ec762ebf398e85758977dac4388f22d72f301d548c0db9b2dcf", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "page": 3, "force": "permission", "binds": "MSDE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "A member of the collaborative may not receive compensation as a member of the collaborative", "span": {"start": 6253, "end": 6344, "sha256": "6b7a03282b2c63db227967106970981ed4e80c713a782958be535c24bacf030f", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "page": 3, "force": "prohibition", "binds": "A member of the collaborative", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "is entitled to reimbursement for expenses under standard State  travel  regulations", "span": {"start": 6349, "end": 6432, "sha256": "f6d436aca4318f7bdae894d62efba2d28932fd13cc26c6a7339000346c0735bf", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "page": 3, "force": "permission", "binds": "A member of the collaborative", "responsible_party_stated": true, "mechanism_stated": "under standard State  travel  regulations"}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The collaborative must, by January 1, 2027, recommend a process for the State Board of Education to update on a regular basis relevant State content standards to address the role of  AI.", "span": {"start": 6646, "end": 6832, "sha256": "c198d15c857e8dc6142ca3ee0c16582128d68dc191059404c8ee2347ec58195c", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "page": 3, "force": "obligation", "binds": "The collaborative", "responsible_party_stated": true, "mechanism_stated": "by January 1, 2027"}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "By  December  1,  2027,  and  annually  thereafter,  the  collaborative  must  report specified findings and recommendations relating to AI to the State Board of Education, the Accountability and Implementation Board, and the General Assembly.", "span": {"start": 6834, "end": 7077, "sha256": "86044ecb3411334d97e2b819d2d961171ed9eed2831b2f61a9d51673293804a8", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "page": 3, "force": "obligation", "binds": "the  collaborative", "responsible_party_stated": true, "mechanism_stated": "By  December  1,  2027,  and  annually  thereafter"}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "'Artificial intelligence' means a machine-based system that (1) can, for a given set of human-defined objectives, make predictions, recommendations, or decisions influencing  real  or  virtual  environments;  (2)  uses  machine  and  human-based  inputs  to perceive real and virtual environments and abstracts those perceptions into models through analysis in an automated manner; and (3) uses model inference to formulate options for information or action.", "span": {"start": 7092, "end": 7550, "sha256": "76366b7ad3d5ec53989d34fd32319b2635ad8710deea648c4d31c1d5a7e6c545", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "page": 4, "term": "Artificial intelligence"}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "reference", "text": "Chapter 496 of 2024", "span": {"start": 7552, "end": 7571, "sha256": "49dbb3b1578e8d84bb9d28002ee730c37e40c8c952e318271896e15d2faa6447", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "page": 4, "target": "ref:chapter_496_of_2024", "target_kind": "external", "cited_instrument": "Chapter 496 of 2024"}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Beginning July 1, 2025, a unit of State government may not procure or deploy a new system that employs AI unless the system complies with the policies and procedures adopted by DoIT.", "span": {"start": 7759, "end": 7941, "sha256": "3cea6cfd0b3a67f08f246f0fe3d4fdb7e310ad79451f29c3e7fec168ffe56133", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "page": 4, "force": "prohibition", "binds": "a unit of State government", "responsible_party_stated": true, "mechanism_stated": "Beginning July 1, 2025"}
{"unit": "md-hb1057-fiscal-note#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40265d75ac42705cd967a5af68044c3c4e380f8e260c26108bce95a4dc58fe32", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "the bill requires that local school systems procure AI tools consistent with the standards adopted by DoIT.", "span": {"start": 8015, "end": 8122, "sha256": "54e7145bb74b0da2bf18f532a28d6f0ed5473f40073d1bf8bad42c1c62427d8c", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Maryland AI Education Collaborative on Artificial Intelligence in K-12 Education", "page": 4, "force": "obligation", "binds": "local school systems", "responsible_party_stated": true, "mechanism_stated": "consistent with the standards adopted by DoIT"}
{"unit": "md-hb1057-fiscal-note#u003", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3492504f3049186df27e4185ef42a7558efc7a67d54b0467f5dc219b010c4bda", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "Artificial intelligence (AI) is a broad field of computer science that deals with the creation of  'intelligent'  systems  that  can  reason,  learn,  and  act  autonomously.", "span": {"start": 13469, "end": 13643, "sha256": "fabe4d2a41a7de3ad2fe0699223d8557e77b69259daac60366a2003d1d4f51ef", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Artificial Intelligence - Generally", "page": 7, "term": "Artificial intelligence (AI)"}
{"unit": "md-hb1057-fiscal-note#u003", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "3492504f3049186df27e4185ef42a7558efc7a67d54b0467f5dc219b010c4bda", "prompt_version": "extract_v1"}, "status": "grounded", "item": "reference", "text": "SB 906", "span": {"start": 12515, "end": 12521, "sha256": "f6757a3dc1b06d20a06b17e18f656c7382f0a0fa7c66952a62009780ec9fe255", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Additional Information", "page": 5, "target": "ref:sb_906_2025", "target_kind": "external", "cited_instrument": "SB 906 (2025)"}
