{"unit": "md-hb1057-fiscal-note#u004", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "758472f0a587da6ea9c6c756d13a70fe6ddcad0dc52c3894ec23f15a94d0f10b", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "The  State  defines  AI  as  a  machine-based  system  that  (1)  can,  for  a  given  set  of human-defined objectives, make predictions, recommendations, or decisions influencing real or virtual environments; (2) uses machine and human-based inputs to perceive real and virtual environments and abstracts those perceptions into models through analysis in an automated manner; and (3) uses model inference to formulate options for information or action.", "span": {"start": 15849, "end": 16303, "sha256": "2a74d090b46e0a96838b150f77d5553d988a0a9666ec26758802992afdad0951", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Governance at the State Level", "page": 8, "term": "AI"}
{"unit": "md-hb1057-fiscal-note#u004", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "758472f0a587da6ea9c6c756d13a70fe6ddcad0dc52c3894ec23f15a94d0f10b", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "requires DoIT to adopt policies and procedures, in consultation with the Governor's AI Subcabinet, concerning the development, procurement, deployment, use, and ongoing  assessment  of  systems  that  employ  high-risk  AI  by  a  unit  of  State government", "span": {"start": 16548, "end": 16805, "sha256": "b57dbc4a97feb7af795c7334cd5450bbcc35030540c49c13fdbed93c87076a15", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Governance at the State Level", "page": 8, "force": "obligation", "binds": "DoIT", "responsible_party_stated": true, "mechanism_stated": "in consultation with the Governor's AI Subcabinet"}
{"unit": "md-hb1057-fiscal-note#u004", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "758472f0a587da6ea9c6c756d13a70fe6ddcad0dc52c3894ec23f15a94d0f10b", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "prohibits units of State government from procuring or deploying a new system that employs AI unless the system complies with the policies and procedures adopted by DoIT", "span": {"start": 16810, "end": 16978, "sha256": "8d48d26c2006678a930d577ede738efc8835d6b5206c363c4696c1f1a2282b65", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Governance at the State Level", "page": 8, "force": "prohibition", "binds": "units of State government", "responsible_party_stated": true, "mechanism_stated": "unless the system complies with the policies and procedures adopted by DoIT"}
{"unit": "md-hb1057-fiscal-note#u004", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "758472f0a587da6ea9c6c756d13a70fe6ddcad0dc52c3894ec23f15a94d0f10b", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "requires each unit of State government to conduct a data inventory to identify data that meets criteria established by the Chief Data Officer and that is (1) necessary for the operations of the unit or otherwise required to be collected as a condition to receive federal funds or by federal or State law and (2) in a form prescribed by the Chief Data Officer, including when the data is used in AI", "span": {"start": 16983, "end": 17380, "sha256": "33313d2e6cbd74d140de23c54eff7e08eba8cf509979bb1d18662d2133d1c22e", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Governance at the State Level", "page": 8, "force": "obligation", "binds": "each unit of State government", "responsible_party_stated": true, "mechanism_stated": "criteria established by the Chief Data Officer"}
{"unit": "md-hb1057-fiscal-note#u004", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "758472f0a587da6ea9c6c756d13a70fe6ddcad0dc52c3894ec23f15a94d0f10b", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "requires  each  unit  of  State  government  to  conduct  an  inventory  of  systems  that employ high-risk AI", "span": {"start": 17389, "end": 17499, "sha256": "74feec9c7b036c2074db4db8db48b487f20971b946185390fa4b19487c4f3f4f", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Governance at the State Level", "page": 8, "force": "obligation", "binds": "each unit of State government", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u004", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "758472f0a587da6ea9c6c756d13a70fe6ddcad0dc52c3894ec23f15a94d0f10b", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "pharmacy benefits manager, or a private review agent that uses AI, algorithms, or other software tools for utilization review (including working through an entity that uses such tools) to ensure that such tools are used in a specified manner", "span": {"start": 19009, "end": 19250, "sha256": "8e5b63510867c434e19a94c396e81315c3d0abd9fecf7497f58b14dc0184df4d", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Other Recent State Laws and Policies", "page": 9, "force": "obligation", "binds": "pharmacy benefits manager, or a private review agent", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u004", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "758472f0a587da6ea9c6c756d13a70fe6ddcad0dc52c3894ec23f15a94d0f10b", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "an AI, algorithm, or other software tool may not deny, delay, or modify health care services", "span": {"start": 19284, "end": 19376, "sha256": "a2409adb1db431b0fe60a03fa8a31cabc86b3da370d2c0f4a5f2e5204aa04058", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Other Recent State Laws and Policies", "page": 9, "force": "prohibition", "binds": "an AI, algorithm, or other software tool", "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "md-hb1057-fiscal-note#u004", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "758472f0a587da6ea9c6c756d13a70fe6ddcad0dc52c3894ec23f15a94d0f10b", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "carriers must submit in their quarterly appeals and grievance reports whether an AI, algorithm, or other software tool was used in making an adverse decision", "span": {"start": 19386, "end": 19543, "sha256": "d2f6731180afa9e00e42a06f039391cb55aca03ffe68bf57fa36c7f221a0cac6", "parsed_sha256": "dc35d71432776ccc7cbd07c68d0f76fe0fa81da72a8500e139145e014142a49e"}, "matches_in_unit": 1, "section_path": "Other Recent State Laws and Policies", "page": 9, "force": "obligation", "binds": "carriers", "responsible_party_stated": true, "mechanism_stated": "in their quarterly appeals and grievance reports"}
