{"unit": "ppra-20usc1232h#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40db36b5167f58bffc34b31b8b80a8d3c4ee34797a07baf7ebb484f66457ed82", "prompt_version": "extract_v1"}, "status": "grounded", "item": "reference", "text": "paragraph (2)", "span": {"start": 7244, "end": 7257, "sha256": "89a67d575b45ba1af874f85e18d390b52a53fc537baa2c29d54ffdfcca0db2f3", "parsed_sha256": "9574099a0139d904395ae25bf051ae483580070962ff726e98cf2d8755408ed7"}, "matches_in_unit": 1, "section_path": "§1232h. Protection of pupil rights > (3) Existing policies", "page": null, "target": "ppra-20usc1232h", "target_kind": "work", "cited_instrument": "20 U.S.C. 1232h(c)(2)"}
{"unit": "ppra-20usc1232h#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "40db36b5167f58bffc34b31b8b80a8d3c4ee34797a07baf7ebb484f66457ed82", "prompt_version": "extract_v1"}, "status": "grounded", "item": "reference", "text": "Paragraph (1)(E)", "span": {"start": 7324, "end": 7340, "sha256": "a8d67f20056cf39e80907eccff933964a0fe220d2fc50986e6eb45c05e6b5d69", "parsed_sha256": "9574099a0139d904395ae25bf051ae483580070962ff726e98cf2d8755408ed7"}, "matches_in_unit": 1, "section_path": "§1232h. Protection of pupil rights > (A) Educational products or services", "page": null, "target": "ppra-20usc1232h", "target_kind": "work", "cited_instrument": "20 U.S.C. 1232h(c)(1)(E)"}
{"unit": "ppra-20usc1232h#u002", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "563902e0efade1b2df19e30b162fc5938dae1a79cbf3b37b80d88bc067b32c69", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The Secretary shall annually inform each State educational agency and each local educational agency of the educational agen cy's obligations under this section and section 1232g of this title.", "span": {"start": 9360, "end": 9552, "sha256": "a7f9325decc27ac6b833295a4e4cf5525fda2258f4d3c5b5e8f6c00d497826a3", "parsed_sha256": "9574099a0139d904395ae25bf051ae483580070962ff726e98cf2d8755408ed7"}, "matches_in_unit": 1, "section_path": "§1232h. Protection of pupil rights > (C) Information activities", "page": null, "force": "obligation", "binds": "The Secretary", "responsible_party_stated": true, "mechanism_stated": "annually"}
{"unit": "ppra-20usc1232h#u002", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "563902e0efade1b2df19e30b162fc5938dae1a79cbf3b37b80d88bc067b32c69", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "A State educational agency or local educational agency may use funds provided under part A of title IV of the Elementary and Secondary Education Act of 1965 [20 U.S.C. 7101 et seq.] to enhance parental involvement in areas affecting the in-school privacy of students.", "span": {"start": 9572, "end": 9839, "sha256": "ea2f696b1c02b0b3899554e6de0c1e950561b2c96349b6afc5ad9f0b9ce23292", "parsed_sha256": "9574099a0139d904395ae25bf051ae483580070962ff726e98cf2d8755408ed7"}, "matches_in_unit": 1, "section_path": "§1232h. Protection of pupil rights > (D) Funding", "page": null, "force": "permission", "binds": "A State educational agency or local educational agency", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "ppra-20usc1232h#u002", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "563902e0efade1b2df19e30b162fc5938dae1a79cbf3b37b80d88bc067b32c69", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "The term \"instructional material\" means instructional content that is provided to a student, regardless of its format, including printed or representational materials, audio-visual materials, and materials in electronic or digital formats (such as materials accessible through the Internet).", "span": {"start": 9925, "end": 10216, "sha256": "bf00666008ca27f1469b2b6e426df5726f360e51ef98f4d67dd2a9b32b3db799", "parsed_sha256": "9574099a0139d904395ae25bf051ae483580070962ff726e98cf2d8755408ed7"}, "matches_in_unit": 1, "section_path": "§1232h. Protection of pupil rights > (A) Instructional material", "page": null, "term": "instructional material"}
{"unit": "ppra-20usc1232h#u002", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "563902e0efade1b2df19e30b162fc5938dae1a79cbf3b37b80d88bc067b32c69", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "The term \"invasive physical examination\" means any medical examination that involves the exposure of private body parts, or any act during such examination that includes incision, insertion, or injection into the body, but does not include a hearing, vision, or scoliosis screening.", "span": {"start": 10324, "end": 10606, "sha256": "42ce1c3e6666c96c5d07c1d4d2f139539e4fe5e8d26327f59df25c401af18e55", "parsed_sha256": "9574099a0139d904395ae25bf051ae483580070962ff726e98cf2d8755408ed7"}, "matches_in_unit": 1, "section_path": "§1232h. Protection of pupil rights > (B) Invasive physical examination", "page": null, "term": "invasive physical examination"}
{"unit": "ppra-20usc1232h#u002", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "563902e0efade1b2df19e30b162fc5938dae1a79cbf3b37b80d88bc067b32c69", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "The term \"local educational agency\" means an elementary school, secondary school, school district, or local board of education that is the recipient of funds under an applicable program, but does not include a postsecondary institution.", "span": {"start": 10643, "end": 10879, "sha256": "9c70bdc21de4ab3821ffcaf55d319ac33e4e2c50994bc8f9344caebec09b278f", "parsed_sha256": "9574099a0139d904395ae25bf051ae483580070962ff726e98cf2d8755408ed7"}, "matches_in_unit": 1, "section_path": "§1232h. Protection of pupil rights > (C) Local educational agency", "page": null, "term": "local educational agency"}
{"unit": "ppra-20usc1232h#u002", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "563902e0efade1b2df19e30b162fc5938dae1a79cbf3b37b80d88bc067b32c69", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "The term \"parent\" includes a legal guardian or other person standing in loco parentis (such as a grandparent or stepparent with whom the child lives, or a person who is legally responsible for the welfare of the child).", "span": {"start": 10898, "end": 11117, "sha256": "265e9e4decab75009fc784d8b9c0846b4c4f24335161ab5def9c3c80e9cf3d86", "parsed_sha256": "9574099a0139d904395ae25bf051ae483580070962ff726e98cf2d8755408ed7"}, "matches_in_unit": 1, "section_path": "§1232h. Protection of pupil rights > (D) Parent", "page": null, "term": "parent"}
