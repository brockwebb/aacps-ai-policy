{"unit": "msde-01-k12-guidance-exec-summary#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d9f1f32d7bd8e93858b88334c6f4f169c89dd18939a2e9b7959e1062afc5774e", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "students are expected to use AI transparently and responsibly.", "span": {"start": 713, "end": 775, "sha256": "6540551815223db2ccf1b97644eb4c1fd38dd6b625f6a64b0f5003f2101a0bdd", "parsed_sha256": "723ecc5559a2ea1babb0e6565355a7507622e0ef7dfbfde549d9ac3c0a5714a5"}, "matches_in_unit": 1, "section_path": "Executive Summary", "page": 1, "force": "obligation", "binds": "students", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-01-k12-guidance-exec-summary#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d9f1f32d7bd8e93858b88334c6f4f169c89dd18939a2e9b7959e1062afc5774e", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AI may support differentiation, feedback, and access, but must not replace human relationships, professional judgment, or essential skill development.", "span": {"start": 1049, "end": 1199, "sha256": "80eeb5ca46f26b058e5d052a928a80dfcaaeae42002c978921251b74d0de4a9e", "parsed_sha256": "723ecc5559a2ea1babb0e6565355a7507622e0ef7dfbfde549d9ac3c0a5714a5"}, "matches_in_unit": 1, "section_path": "EIGHT CRITICAL ELEMENTS", "page": 1, "force": "prohibition", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-01-k12-guidance-exec-summary#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d9f1f32d7bd8e93858b88334c6f4f169c89dd18939a2e9b7959e1062afc5774e", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AI systems must be monitored for bias and disparate impact.", "span": {"start": 1238, "end": 1297, "sha256": "e6f376deac1d20f9ceeb7c80579092061f711beaa418ae89b38551b50a25a52f", "parsed_sha256": "723ecc5559a2ea1babb0e6565355a7507622e0ef7dfbfde549d9ac3c0a5714a5"}, "matches_in_unit": 1, "section_path": "EIGHT CRITICAL ELEMENTS", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-01-k12-guidance-exec-summary#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d9f1f32d7bd8e93858b88334c6f4f169c89dd18939a2e9b7959e1062afc5774e", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Access to AIsupported learning must not widen opportunity gaps.", "span": {"start": 1298, "end": 1361, "sha256": "e8e99a1f134dead36325fad07293110a911984487c579a4fd7e8a36332d305e2", "parsed_sha256": "723ecc5559a2ea1babb0e6565355a7507622e0ef7dfbfde549d9ac3c0a5714a5"}, "matches_in_unit": 1, "section_path": "EIGHT CRITICAL ELEMENTS", "page": 1, "force": "prohibition", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-01-k12-guidance-exec-summary#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d9f1f32d7bd8e93858b88334c6f4f169c89dd18939a2e9b7959e1062afc5774e", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AI integration must comply with FERPA, COPPA, PPRA, IDEA, ADA, Section 504, COMAR, and applicable Maryland law.", "span": {"start": 1453, "end": 1564, "sha256": "ca784da42785a9469bc942763918667a8692f5a71a96e559fe6885ebb2a5eee3", "parsed_sha256": "723ecc5559a2ea1babb0e6565355a7507622e0ef7dfbfde549d9ac3c0a5714a5"}, "matches_in_unit": 1, "section_path": "EIGHT CRITICAL ELEMENTS", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-01-k12-guidance-exec-summary#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d9f1f32d7bd8e93858b88334c6f4f169c89dd18939a2e9b7959e1062afc5774e", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Districts must enforce data minimization, contractual safeguards, and cybersecurity protections.", "span": {"start": 1565, "end": 1661, "sha256": "9a84f237830ed3fb800b4c15d9bac4fcb94f6db914fef1bacee6b1ebea7ffb0e", "parsed_sha256": "723ecc5559a2ea1babb0e6565355a7507622e0ef7dfbfde549d9ac3c0a5714a5"}, "matches_in_unit": 1, "section_path": "EIGHT CRITICAL ELEMENTS", "page": 1, "force": "obligation", "binds": "Districts", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-01-k12-guidance-exec-summary#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d9f1f32d7bd8e93858b88334c6f4f169c89dd18939a2e9b7959e1062afc5774e", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Schools must clearly define appropriate AI use, require transparency when AI is permitted, and redesign assessments to emphasize reasoning, process, and authentic demonstration of learning rather than reliance on detection tools.", "span": {"start": 1698, "end": 1927, "sha256": "bfffb007d1e5742c1e3d410bb510dee51c1f0bdf401fbfb51a4c5283d1d00528", "parsed_sha256": "723ecc5559a2ea1babb0e6565355a7507622e0ef7dfbfde549d9ac3c0a5714a5"}, "matches_in_unit": 1, "section_path": "EIGHT CRITICAL ELEMENTS", "page": 1, "force": "obligation", "binds": "Schools", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-01-k12-guidance-exec-summary#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d9f1f32d7bd8e93858b88334c6f4f169c89dd18939a2e9b7959e1062afc5774e", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Rolespecific professional learning must equip teachers, leaders, and staff to evaluate AI outputs critically and use tools responsibly.", "span": {"start": 2025, "end": 2160, "sha256": "539e31e5299f41d99bcde00b949b8c79a6cc8c3a3640faf46357876fcab50e13", "parsed_sha256": "723ecc5559a2ea1babb0e6565355a7507622e0ef7dfbfde549d9ac3c0a5714a5"}, "matches_in_unit": 1, "section_path": "EIGHT CRITICAL ELEMENTS", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "msde-01-k12-guidance-exec-summary#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d9f1f32d7bd8e93858b88334c6f4f169c89dd18939a2e9b7959e1062afc5774e", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Students must develop the knowledge and skills to understand how AI systems function, evaluate bias and limitations, protect privacy, and use AI ethically across disciplines and grade levels.", "span": {"start": 2203, "end": 2394, "sha256": "8dbb9507f2ab4e63407b33555f6d7c786d534cf57e5219ce758e3bd4e18cc1b2", "parsed_sha256": "723ecc5559a2ea1babb0e6565355a7507622e0ef7dfbfde549d9ac3c0a5714a5"}, "matches_in_unit": 1, "section_path": "EIGHT CRITICAL ELEMENTS", "page": 1, "force": "obligation", "binds": "Students", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-01-k12-guidance-exec-summary#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d9f1f32d7bd8e93858b88334c6f4f169c89dd18939a2e9b7959e1062afc5774e", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "High-stakes operational systems, including predictive analytics and automated decision-support tools, require documented human review, equity monitoring, and transparent communication.", "span": {"start": 2441, "end": 2625, "sha256": "217d772120c13e202a24d97652325a2e0143aed7109023149d26db7f84ba9de8", "parsed_sha256": "723ecc5559a2ea1babb0e6565355a7507622e0ef7dfbfde549d9ac3c0a5714a5"}, "matches_in_unit": 1, "section_path": "EIGHT CRITICAL ELEMENTS", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
