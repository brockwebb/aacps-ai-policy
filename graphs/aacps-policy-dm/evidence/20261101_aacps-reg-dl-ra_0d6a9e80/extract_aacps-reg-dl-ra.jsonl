{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall have a data privacy and security incident response plan.", "span": {"start": 2354, "end": 2422, "sha256": "538d97413cee679025abbc3115ca41672abd55be5ae98e81a33e453d46c25ef4", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall have a security breach notification plan.", "span": {"start": 2427, "end": 2480, "sha256": "2ef1593268c9d376d2d3385a85ec78157f5a21aac7a2b07a401b0c88e04b813e", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall maintain cyber security incident response guidelines and data breach notification procedures.", "span": {"start": 2485, "end": 2590, "sha256": "60a87bd65a57569665d1357ed49e3326041e3221727b5ffb3644d8be8a941d77", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall:\n\na. Create and implement a data classification plan for all AACPS data to determine data sensitivity levels;", "span": {"start": 2595, "end": 2716, "sha256": "c5ae8d313004f55815412ae399e814dd2c1306dccf82ce47cad80c745e8cdd5f", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Establish and maintain security controls to be implemented, in accordance with the classification plan, for each identified data security level.", "span": {"start": 2725, "end": 2869, "sha256": "99b5f08d55fba648e713ee33272545f57010d0037b65680b42d09d116843323b", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": "in accordance with the classification plan"}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The Superintendent or the Chief Information Officer shall identify and assign data owners and data stewards who shall oversee the collection, use, sharing, and destruction of data.", "span": {"start": 2874, "end": 3054, "sha256": "eae4fa08b1e53062175655018dd18780c3a25ecf0cbdb1805cc16835296e6a49", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "obligation", "binds": "The Superintendent or the Chief Information Officer", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall establish procedures and requirements for allowing access to student data and personally identifiable information (PII) for a legitimate research purpose.", "span": {"start": 3059, "end": 3225, "sha256": "fee64b780d5dd9389e6ed22f28357033b87e3845c0512b3b019924ad8bf722d6", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Electronic resources containing student PII may only be approved for use in accordance with the following data privacy guidelines.", "span": {"start": 3226, "end": 3356, "sha256": "58929798839bb5802a17014fb456e8bd59babf241c5810c09c23d3bac5581156", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "prohibition", "binds": null, "responsible_party_stated": false, "mechanism_stated": "in accordance with the following data privacy guidelines"}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Communications between the client software, including web browsers, file uploads, file downloads, and the system and data at rest, shall be encrypted using current Federal Information Processing Standard 140-2 or another AACPSapproved equivalent standard to ensure confidentiality, integrity, and availability of AACPS-owned data.", "span": {"start": 3361, "end": 3691, "sha256": "5a53a6d64cf82c57d182df84738f26ae522912537d73e13f4a04cf89f3e0d28d", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": "using current Federal Information Processing Standard 140-2 or another AACPSapproved equivalent standard"}
