{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "In accordance with State law, AACPS commits to implementing best practices on data governance and professional development on data governance policies and procedures.", "span": {"start": 454, "end": 620, "sha256": "9fcdecd126e22e40840342805b79f9bcc9c6e731adc757099c41f42eca12d62d", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "B. BACKGROUND", "page": 1, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": "In accordance with State law"}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "Data Owner - an individual who has the requisite knowledge, administrative control, and has been officially designated as accountable for specific data elements or data sets.", "span": {"start": 1408, "end": 1582, "sha256": "2222c4db4b189d4c39a92392f2be0cb7b4e3f002ac7b8a0560500afcbcdf7c6e", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "C. DEFINITIONS", "page": 1, "term": "Data Owner"}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "Data Steward - an individual who is responsible for maintaining data quality and security.", "span": {"start": 1587, "end": 1677, "sha256": "892a06f130868f0f1f93ed2ed674df0478997370a4841f3c90986d243fcfb554", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "C. DEFINITIONS", "page": 1, "term": "Data Steward"}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "Education Records - those records that are directly related to a student and maintained by AACPS or by a party acting for AACPS.", "span": {"start": 1682, "end": 1810, "sha256": "4fc0810dc13cdb41b18b24607c8d5d0743a511dc718f47bfeb6ae922599e074f", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "C. DEFINITIONS", "page": 1, "term": "Education Records"}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "Personally Identifiable Information - information that, alone or in combination, makes it possible to identify an individual student with reasonable certainty.", "span": {"start": 1815, "end": 1974, "sha256": "aeeda40fb2aefb4208695d44c7e43a5e0719127c9f5bc6bea452423c6c097020", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "C. DEFINITIONS", "page": 2, "term": "Personally Identifiable Information"}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS shall continuously improve the availability, integrity, and security of data systems through the development and enforcement of laws, policies, and regulations.", "span": {"start": 1991, "end": 2157, "sha256": "662b6b5711eba2768e8b340b0734d97822f4c27aeb969ccb3b4a0b8d28248f60", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": "through the development and enforcement of laws, policies, and regulations"}
{"unit": "aacps-reg-dl-ra#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "b2ebf501a34b90853a349f831c9bdc7d7351438cd413d9e77989ba639199c8a9", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Accordingly, data privacy protection of AACPS technology, related data, and electronic communications shall be in accordance with Policy DI and Regulation DI-RA - Technology Use and Security.", "span": {"start": 2158, "end": 2349, "sha256": "a004b4cf2a1bbd02ebd2ca9bc4df4eba43fe051f7c49a4f5799221002650c46d", "parsed_sha256": "e7ae825f954228cae1563de8cf5af180ab04fb1a63d987f626ac30bd2c5e3b92"}, "matches_in_unit": 1, "section_path": "D. PROCEDURES", "page": 2, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": "in accordance with Policy DI and Regulation DI-RA - Technology Use and Security"}
