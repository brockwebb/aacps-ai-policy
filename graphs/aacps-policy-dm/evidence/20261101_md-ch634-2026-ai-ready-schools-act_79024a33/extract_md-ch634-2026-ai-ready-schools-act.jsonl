{"unit": "md-ch634-2026-ai-ready-schools-act#u002", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d2cb1bf0741abfb5b7988c0466c5d51302b15afd2ed222e2f287e2abaee94a9a", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "THE COLLABORATIVE SHALL:\n(1) STUDY THE USES OF ARTIFICIAL INTELLIGENCE IN EACH LOCAL\nSCHOOL SYSTEM, INCLUDING A REVIEW OF INNOVATION BY INDUSTRY AND\nPHILANTHROPIC SUPPORT OF SCHOOLS IN THE USE OF ARTIFICIAL INTELLIGENCE", "span": {"start": 9763, "end": 9982, "sha256": "a6f05071a6cee6783e4d2db6c3784cd50bf5de22b4ab92726957a1b98a27a9d9", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 7", "page": null, "force": "obligation", "binds": "THE COLLABORATIVE", "responsible_party_stated": true, "mechanism_stated": null}
