{"unit": "md-ch634-2026-ai-ready-schools-act#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "71d1af27403143e140a59a7889618e502cf49e83e48210f0766ebe761a2e9e38", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "IN THIS SUBTITLE, “ARTIFICIAL INTELLIGENCE” HAS THE MEANING STATED\nIN § 3.5–801 OF THE STATE FINANCE AND PROCUREMENT ARTICLE.", "span": {"start": 2547, "end": 2672, "sha256": "5ff94af5c798dafbb3d0235809d4a0ab271b13546707e74e536c381cdecbb3bc", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 2", "page": null, "term": "ARTIFICIAL INTELLIGENCE"}
{"unit": "md-ch634-2026-ai-ready-schools-act#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "71d1af27403143e140a59a7889618e502cf49e83e48210f0766ebe761a2e9e38", "prompt_version": "extract_v1"}, "status": "grounded", "item": "reference", "text": "§ 3.5–801 OF THE STATE FINANCE AND PROCUREMENT ARTICLE", "span": {"start": 2617, "end": 2671, "sha256": "257534d08970ac7109e1c0d329f914c7f4dd5256bbb84d89105e3f46e1bfc086", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 2", "page": null, "target": "ref:section_3_5_801_of_the_state_finance_and_procurement_article", "target_kind": "external", "cited_instrument": "Section 3.5-801 of the State Finance and Procurement Article"}
{"unit": "md-ch634-2026-ai-ready-schools-act#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "71d1af27403143e140a59a7889618e502cf49e83e48210f0766ebe761a2e9e38", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "THE DEPARTMENT SHALL PROVIDE GUIDANCE ON ARTIFICIAL\nINTELLIGENCE TO LOCAL SCHOOL SYSTEMS, EDUCATORS, PARENTS, AND STUDENTS\nTHROUGH AN ONLINE PLATFORM THAT:", "span": {"start": 2689, "end": 2844, "sha256": "fe8caeb89a7954b0beff4bece17693289fceba376780d2f0bff444cdcf99c2a7", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 2", "page": null, "force": "obligation", "binds": "THE DEPARTMENT", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "71d1af27403143e140a59a7889618e502cf49e83e48210f0766ebe761a2e9e38", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "THE DEPARTMENT, IN CONSULTATION WITH OTHER INTERESTED\nSTAKEHOLDERS, SHALL PUBLISH SEPARATELY ON ITS WEBSITE GUIDANCE FOR\nEACH OF THE FOLLOWING GROUPS:", "span": {"start": 3349, "end": 3499, "sha256": "1f712898e6fceee20e4be48aef600e40891dfdd335cb355fedd6abb85f5deea6", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 2", "page": null, "force": "obligation", "binds": "THE DEPARTMENT", "responsible_party_stated": true, "mechanism_stated": "IN CONSULTATION WITH OTHER INTERESTED STAKEHOLDERS"}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "EACH YEAR, THE DEPARTMENT SHALL REVIEW THE GUIDANCE\nAND UPDATE THE GUIDANCE AS NECESSARY.", "span": {"start": 3634, "end": 3723, "sha256": "28d121451e20821482097f20534fda4c23e58eb2527613088766b980fef17b76", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 3", "page": null, "force": "obligation", "binds": "THE DEPARTMENT", "responsible_party_stated": true, "mechanism_stated": "EACH YEAR"}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "THE DEPARTMENT SHALL DEVELOP STRATEGIES TO ASSIST COUNTY\nBOARDS AND COUNTY SUPERINTENDENTS TO IMPLEMENT THE GUIDELINES AND\nBEST PRACTICES DEVELOPED BY THE DEPARTMENT UNDER THIS SECTION.", "span": {"start": 3728, "end": 3913, "sha256": "9646cd11688bdf1069db8646f7fe0fd30acaf1ad000d382c1968877f88307c95", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 3", "page": null, "force": "obligation", "binds": "THE DEPARTMENT", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "ON OR BEFORE 120 DAYS FROM THE DATE THAT THE DEPARTMENT\nRELEASES THE GUIDANCE REQUIRED UNDER SUBSECTION (A)(1) OF THIS SECTION,\nEACH LOCAL SCHOOL SYSTEM SHALL HAVE AN ARTIFICIAL INTELLIGENCE POLICY\nALIGNED WITH THE GUIDANCE.", "span": {"start": 3918, "end": 4142, "sha256": "8067ff2d57dab6d59a154f5a2b54ad1da954b2f72f14a12edf098ae4ecc96dd6", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 3", "page": null, "force": "obligation", "binds": "EACH LOCAL SCHOOL SYSTEM", "responsible_party_stated": true, "mechanism_stated": "ON OR BEFORE 120 DAYS FROM THE DATE THAT THE DEPARTMENT RELEASES THE GUIDANCE"}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "EACH LOCAL SCHOOL SYSTEM SHALL DESIGNATE\nA COORDINATOR BETWEEN THE LOCAL SCHOOL SYSTEM AND THE STATE ON THE\nPRODUCTIVE AND ETHICAL USE OF SYSTEMS OF ARTIFICIAL INTELLIGENCE IN THE\nLOCAL SCHOOL SYSTEM.", "span": {"start": 4151, "end": 4351, "sha256": "a357808e4c758552f607c4852c712a4cf0e27444598c260f0a85dc71a592c8e2", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 3", "page": null, "force": "obligation", "binds": "EACH LOCAL SCHOOL SYSTEM", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "A COORDINATOR DESIGNATED UNDER PARAGRAPH (1) OF THIS\nSUBSECTION SHALL BE AN INDIVIDUAL WHO IS EMPLOYED AT THE CENTRAL OFFICE\nADMINISTRATION LEVEL AS NONINSTRUCTIONAL STAFF.", "span": {"start": 4356, "end": 4528, "sha256": "ce9c26d080aa50f2908a3661f39005de21c2cf4b63b941dc0ae1ebe5d784fa28", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 3", "page": null, "force": "obligation", "binds": "A COORDINATOR DESIGNATED UNDER PARAGRAPH (1) OF THIS SUBSECTION", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "THE DEPARTMENT SHALL DEVELOP AND PUBLISH A RUBRIC AND\nOTHER EVALUATIVE TOOLS, AS NECESSARY, TO ASSIST LOCAL SCHOOL SYSTEMS IN\nTHE EVALUATION OF ARTIFICIAL INTELLIGENCE TOOLS SELECTED FOR USE BY THE\nLOCAL SCHOOL SYSTEM.", "span": {"start": 4543, "end": 4761, "sha256": "0f9e6bd2980160ad1f036bfdfc9b5ca2f9ae3b58edd01c6f985783771880747e", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 3", "page": null, "force": "obligation", "binds": "THE DEPARTMENT", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "THE RUBRIC SHALL BE DESIGNED TO SUPPORT LOCAL SCHOOL\nSYSTEMS IN DETERMINING WHETHER ARTIFICIAL INTELLIGENCE TOOLS ARE\nCONSISTENT WITH STATE GUIDELINES.", "span": {"start": 4766, "end": 4917, "sha256": "ba1933ac0e3fea2d228122c62dacdb021cc2f97d4360de6d1005f0c491198690", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 3", "page": null, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "EACH LOCAL SCHOOL SYSTEM SHALL USE THE RUBRIC AND\nOTHER EVALUATIVE TOOLS DEVELOPED BY THE DEPARTMENT IN THE REVIEW AND", "span": {"start": 4922, "end": 5040, "sha256": "b5e535004908c42333ffb1e7c56689fbbbcbcab406360c1b05c7431316ed4094", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 3", "page": null, "force": "obligation", "binds": "EACH LOCAL SCHOOL SYSTEM", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "THE DEPARTMENT PERIODICALLY MAY REVIEW AND UPDATE THE\nRUBRIC AS NECESSARY TO REFLECT CHANGES IN TECHNOLOGY, LAW, OR STATE\nPOLICY.", "span": {"start": 5176, "end": 5305, "sha256": "1aa19d17e15b7fb392d8435e173902721870c254e5128de9d9463d70060e4ea3", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 4", "page": null, "force": "permission", "binds": "THE DEPARTMENT", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "ON REQUEST, MORGAN STATE UNIVERSITY, OR ANOTHER 4–YEAR\nINSTITUTION OF HIGHER EDUCATION IN THE STATE, MAY SUPPORT LOCAL SCHOOL\nSYSTEMS IN ASSESSING THE TOOLS AGAINST THE RUBRIC.", "span": {"start": 5310, "end": 5486, "sha256": "47cc3e216d6164d244f875f25da8db245ba4832b1480086786f3e472ba17a3c6", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 4", "page": null, "force": "permission", "binds": "MORGAN STATE UNIVERSITY, OR ANOTHER 4–YEAR INSTITUTION OF HIGHER EDUCATION IN THE STATE", "responsible_party_stated": true, "mechanism_stated": "ON REQUEST"}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "LOCAL SCHOOL SYSTEMS SHALL PROCURE ARTIFICIAL INTELLIGENCE\nTOOLS CONSISTENT WITH THE PROVISIONS OF TITLE 3.5, SUBTITLE 8 OF THE STATE\nFINANCE AND PROCUREMENT ARTICLE.", "span": {"start": 5491, "end": 5657, "sha256": "3db39536553a5a5fea0186b253605bc7c3340f3aae4aa1fdc1c85814ceb5e4e2", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 4", "page": null, "force": "obligation", "binds": "LOCAL SCHOOL SYSTEMS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "reference", "text": "TITLE 3.5, SUBTITLE 8 OF THE STATE\nFINANCE AND PROCUREMENT ARTICLE", "span": {"start": 5590, "end": 5656, "sha256": "ea33a750a7c136c92d05fe452d902127bb69afc3c9b268b3dbea69250ab131e1", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 4", "page": null, "target": "ref:title_3_5_subtitle_8_state_finance_and_procurement_article", "target_kind": "external", "cited_instrument": "Title 3.5, Subtitle 8, State Finance and Procurement Article"}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "ON OR BEFORE JUNE 1, 2027, THE DEPARTMENT, IN CONSULTATION\nWITH THE GOVERNOR’S WORKFORCE DEVELOPMENT BOARD, SHALL ENSURE THAT\nARTIFICIAL INTELLIGENCE LITERACY IS A COMPONENT OF WORKFORCE\nPREPARATION STANDARDS AND COMPUTER SCIENCE STANDARDS FOR\nKINDERGARTEN THROUGH GRADE 12.", "span": {"start": 5670, "end": 5944, "sha256": "7d925b2611a918aed1bc7c5daecd0c400b4c3d77187bd76cbd9c4bb841ba0f09", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 4", "page": null, "force": "obligation", "binds": "THE DEPARTMENT", "responsible_party_stated": true, "mechanism_stated": "ON OR BEFORE JUNE 1, 2027"}
{"unit": "md-ch634-2026-ai-ready-schools-act#u001", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "608ceb42afe704d81fd19ca09f656883fd564f9551c4878dbc338b72783a41a4", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "THE DEPARTMENT SHALL PROVIDE PROFESSIONAL DEVELOPMENT IN\nARTIFICIAL INTELLIGENCE TO EDUCATORS AND SCHOOL LEADERS THAT:", "span": {"start": 5970, "end": 6088, "sha256": "4c1adbd4ac895480bb370aba9351615dd90460ad9ddc8bea51accd884fdae2e9", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 4", "page": null, "force": "obligation", "binds": "THE DEPARTMENT", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u002", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d2cb1bf0741abfb5b7988c0466c5d51302b15afd2ed222e2f287e2abaee94a9a", "prompt_version": "extract_v1"}, "status": "grounded", "item": "definition", "text": "IN THIS SECTION, “COLLABORATIVE” MEANS THE MARYLAND AI\nEDUCATION COLLABORATIVE ON ARTIFICIAL INTELLIGENCE IN K–12 EDUCATION.", "span": {"start": 7215, "end": 7339, "sha256": "40370398a7e769b693521c70e9e4b06ef049bc1c7198511c874a5d5deec1c55b", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 6", "page": null, "term": "COLLABORATIVE"}
{"unit": "md-ch634-2026-ai-ready-schools-act#u002", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d2cb1bf0741abfb5b7988c0466c5d51302b15afd2ed222e2f287e2abaee94a9a", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "IT IS THE INTENT OF THE GENERAL ASSEMBLY THAT THE\nEDUCATORS CONSULTED BY THE COLLABORATIVE\nSHALL REPRESENT DIVERSE SUBJECT AREAS\nAND LICENSURE AREAS, INCLUDING GENERAL AND SPECIAL EDUCATORS.", "span": {"start": 9058, "end": 9248, "sha256": "c55114c593c9e4ba82808977045ac8d57d89e81817e2ab08d6c591db353ea21e", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 7", "page": null, "force": "obligation", "binds": "THE EDUCATORS CONSULTED BY THE COLLABORATIVE", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "md-ch634-2026-ai-ready-schools-act#u002", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "d2cb1bf0741abfb5b7988c0466c5d51302b15afd2ed222e2f287e2abaee94a9a", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "THE STATE SUPERINTENDENT SHALL DESIGNATE THE CHAIR OF THE\nCOLLABORATIVE AND MAY ESTABLISH SUBCOMMITTEES OF THE COLLABORATIVE.", "span": {"start": 9253, "end": 9378, "sha256": "55cd04707f6d3b08d3c0ae46f26d506cbb5e5434725288f3dfe5869ab73ae300", "parsed_sha256": "79024a334e39f596b07642470ce58a3b6fdc0ceae4a15a10bf44abcaffb650d1"}, "matches_in_unit": 1, "section_path": "Page 7", "page": null, "force": "obligation", "binds": "THE STATE SUPERINTENDENT", "responsible_party_stated": true, "mechanism_stated": null}
