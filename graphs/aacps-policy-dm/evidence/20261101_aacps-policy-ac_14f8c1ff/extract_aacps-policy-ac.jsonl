{"unit": "aacps-policy-ac#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "717775666e88cb4a3a2860d7576c02e42268d33a9e66d89761f773075a7a0ec1", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Complaints of unlawful discrimination shall be investigated in accordance with the procedures set forth in AACPS policies and regulations regarding discrimination and biased behavior and language.", "span": {"start": 664, "end": 860, "sha256": "5b3d2250d2eff91a1900608b6b11e4440d10af0efffd9e56d832bb95b544d16b", "parsed_sha256": "00e340e6325182fa07e5b92742e1dfbd5598c016611565ea243d25727463fc3d"}, "matches_in_unit": 1, "section_path": "B. ISSUE", "page": 1, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": "in accordance with the procedures set forth in AACPS policies and regulations regarding discrimination and biased behavior and language"}
{"unit": "aacps-policy-ac#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "717775666e88cb4a3a2860d7576c02e42268d33a9e66d89761f773075a7a0ec1", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "AACPS complies with federal, State, and local laws that prohibit discrimination based on membership of a protected class.", "span": {"start": 1125, "end": 1246, "sha256": "ac6b2ab77fb0edcfc972bcd022f8916a2e52d727a1d18179ba11cd96c0d93cb6", "parsed_sha256": "00e340e6325182fa07e5b92742e1dfbd5598c016611565ea243d25727463fc3d"}, "matches_in_unit": 1, "section_path": "C. POSITION", "page": 1, "force": "obligation", "binds": "AACPS", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-ac#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "717775666e88cb4a3a2860d7576c02e42268d33a9e66d89761f773075a7a0ec1", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The Board prohibits:\n\na. Discrimination in its educational programs and in employment on the basis of actual or perceived race, ethnicity, color, religion, national origin, sex, age, marital status, sexual orientation, genetic information, gender identity, gender expression, disability, homeless status, or military status;", "span": {"start": 1251, "end": 1575, "sha256": "b71f516edd6336411f60e0a467825515bf4823d79455d57652f60166ab9bd7bb", "parsed_sha256": "00e340e6325182fa07e5b92742e1dfbd5598c016611565ea243d25727463fc3d"}, "matches_in_unit": 1, "section_path": "2. The Board prohibits:", "page": 1, "force": "prohibition", "binds": "The Board", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-ac#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "717775666e88cb4a3a2860d7576c02e42268d33a9e66d89761f773075a7a0ec1", "prompt_version": "extract_v1"}, "status": "ungrounded", "why": "text_not_in_passage", "item": "obligation", "text_claimed": "The Board prohibits: b. Refusing to enroll a prospective student, expelling a current student, or withholding privileges from any individual because of an individual's race, ethnicity, color, religion, national origin, sex, age, marital status, sexual orientation, gender identity, gender expression, disability, or homeless status; and"}
{"unit": "aacps-policy-ac#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "717775666e88cb4a3a2860d7576c02e42268d33a9e66d89761f773075a7a0ec1", "prompt_version": "extract_v1"}, "status": "ungrounded", "why": "text_not_in_passage", "item": "obligation", "text_claimed": "The Board prohibits: c. Disciplining, invoking a penalty, or taking any other retaliatory action against a student or parent/guardian of a student who files a complaint alleging that AACPS or a school discriminated against the student, regardless of the outcome of the complaint."}
{"unit": "aacps-policy-ac#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "717775666e88cb4a3a2860d7576c02e42268d33a9e66d89761f773075a7a0ec1", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "In accordance with the law and its commitments, the Board prohibits the use of language and the display of symbols that promote hate, demean an identifiable person or group of persons, or are reasonably perceived as promoting hatred, bullying, cyberbullying, harassment, or intimidation, and can be reasonably forecasted to cause substantial disruption to the orderly operation of a school or AACPS operations or activities.", "span": {"start": 2483, "end": 2907, "sha256": "09ee63eb4a6e6d4e33132fe2000d49f30b21b6d55f65e7166ac1d8a4be17d090", "parsed_sha256": "00e340e6325182fa07e5b92742e1dfbd5598c016611565ea243d25727463fc3d"}, "matches_in_unit": 1, "section_path": "2. The Board prohibits:", "page": 2, "force": "prohibition", "binds": "the Board", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "aacps-policy-ac#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "717775666e88cb4a3a2860d7576c02e42268d33a9e66d89761f773075a7a0ec1", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The use or display of a symbol of hate on AACPS property, on a school bus or other school vehicle, at school-sponsored activities, or in any manner that substantially disrupts the orderly operation of a school regardless of where the incident occurs is prohibited and may be considered a hate crime under federal or State law.", "span": {"start": 3145, "end": 3471, "sha256": "472b41e272de965b2fca39310788c9af96045f674767b1616d7290bcff553aeb", "parsed_sha256": "00e340e6325182fa07e5b92742e1dfbd5598c016611565ea243d25727463fc3d"}, "matches_in_unit": 1, "section_path": "2. The Board prohibits:", "page": 2, "force": "prohibition", "binds": null, "responsible_party_stated": false, "mechanism_stated": null}
{"unit": "aacps-policy-ac#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "717775666e88cb4a3a2860d7576c02e42268d33a9e66d89761f773075a7a0ec1", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Complaints of unlawful discrimination shall be promptly and appropriately investigated in accordance with Policy GAGG and Regulation GAGG-RA - Nondiscrimination and Anti-Harassment - Personnel as well as Policy JO and Regulation JO-RA - Bias Behavior and Language.", "span": {"start": 3476, "end": 3740, "sha256": "b152d67bc9a10caaa49596cfa9e08dee534da97f8e7af86bd48186a6944315f0", "parsed_sha256": "00e340e6325182fa07e5b92742e1dfbd5598c016611565ea243d25727463fc3d"}, "matches_in_unit": 1, "section_path": "2. The Board prohibits:", "page": 2, "force": "obligation", "binds": null, "responsible_party_stated": false, "mechanism_stated": "in accordance with Policy GAGG and Regulation GAGG-RA - Nondiscrimination and Anti-Harassment - Personnel as well as Policy JO and Regulation JO-RA - Bias Behavior and Language"}
