{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "While the Maryland State Department of Education establishes statewide expectations and supports, Local Education Agencies (LEAs) are responsible for evaluating AI tools, ensuring compliance with privacy and civil rights laws, monitoring equity impacts, and guiding responsible classroom and operational use.", "span": {"start": 53, "end": 361, "sha256": "cd5bb15541b386d73f52ff222d9b1f2c6aa3127fa474a419f63f23824d7421e4", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "Key Responsibilities", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "The responsibilities outlined below reflect the essential work districts must undertake to ensure that AI strengthens teaching, learning, and student well-being across Maryland's schools while ensuring it is used safely and ethically.", "span": {"start": 362, "end": 596, "sha256": "acfc458c11234b59b481e54b5168ce599b426e8ad0ca83d855cda44b0300406f", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "Key Responsibilities", "page": 1, "force": "obligation", "binds": "districts", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Adopt or update district AI policies covering instructional use, operational use, data privacy, academic integrity, and human oversight.", "span": {"start": 664, "end": 800, "sha256": "8fb76165dff944870ac0777402a903c72cffb6abf3100310cd4ec8f60c12506b", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "DEVELOP AND MAINTAIN LOCAL AI POLICIES ALIGNED TO STATE GUIDANCE", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Ensure policies reflect statewide principles of equity, transparency, privacy, and responsible innovation.", "span": {"start": 802, "end": 908, "sha256": "28abbcb0070e0e42458070d20b4f2576b4d69ab1d3ec74521e15c87833b0aa88", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "DEVELOP AND MAINTAIN LOCAL AI POLICIES ALIGNED TO STATE GUIDANCE", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Review and revise policies annually as technologies, risks, and local conditions evolve.", "span": {"start": 910, "end": 998, "sha256": "19cbc4e0a0e59dc3f17d2c415d11147949513686782cacaea8235f0d8bf52042", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "DEVELOP AND MAINTAIN LOCAL AI POLICIES ALIGNED TO STATE GUIDANCE", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": "annually"}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Form a multidisciplinary AI governance team (curriculum, IT, data privacy, legal, school administrators, teachers, specialists).", "span": {"start": 1045, "end": 1173, "sha256": "3927dfaa4e38ba64986e00314616210096690e20cc69e48d80bc9c987f53c558", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "ESTABLISH DISTRICT AI GOVERNANCE STRUCTURES", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Define local procedures for tool vetting, pilot approval, escalation pathways, and incident response.", "span": {"start": 1175, "end": 1276, "sha256": "cb57fefc7f0f7839f87e608533eafce5e3f1732378a7b5529aade1713fbe038c", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "ESTABLISH DISTRICT AI GOVERNANCE STRUCTURES", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Ensure governance processes include perspectives representing multilingual learners, students with disabilities, and traditionally marginalized groups.", "span": {"start": 1278, "end": 1429, "sha256": "71ee161b6fa60ed21e45e480bb7a5eeba4f5120083aa021b400459c1b39837b3", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "ESTABLISH DISTRICT AI GOVERNANCE STRUCTURES", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Conduct thorough evaluations using a local rubric or Maryland's provided templates (risk assessments, privacy checklists, equity reviews).", "span": {"start": 1468, "end": 1606, "sha256": "192cc4e638e8377cc0a1233357620991c596d0047e6d34e9eb153509f37ac7a4", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "VET AND APPROVE AI TOOLS BEFORE USE", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": "using a local rubric or Maryland's provided templates"}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Review vendor disclosures on training data, model limitations, data use, accessibility, and known risks.", "span": {"start": 1608, "end": 1712, "sha256": "2245cab7b91ed8958bf3babbfe19048033481bead5313b9ccc39f7b6000d5fb5", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "VET AND APPROVE AI TOOLS BEFORE USE", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Ensure all adopted tools comply with FERPA, COPPA, PPRA, IDEA, Section 504, ADA, COMAR, and district data governance policies.", "span": {"start": 1714, "end": 1840, "sha256": "048bd345c67740581c70f0a6b506a1f0eed5acd1dac1f3fb819416365853e760", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "VET AND APPROVE AI TOOLS BEFORE USE", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Document decisions, including rationale for adoption, rejection, or conditional approval.", "span": {"start": 1842, "end": 1931, "sha256": "a41671d471081f948e307ebdbd63cfc8a0552562c42dee268174c1102289ac29", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "VET AND APPROVE AI TOOLS BEFORE USE", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Evaluate whether AI tools produce disparate impacts across student groups.", "span": {"start": 1988, "end": 2062, "sha256": "498e22e9fe269e0dd1349cf2e1d9fe684785932c9fcb90b5f1db2c174e822fbc", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "MONITOR EQUITY, FAIRNESS, AND IMPACT ACROSS USE CASES", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Monitor predictive systems and operational tools (attendance, early warning, scheduling) for bias, drift, or unintended consequences.", "span": {"start": 2064, "end": 2197, "sha256": "9d71fcee8df9baf66617b85855e1ead3fb3fe789d3ef32aba8de3e6a5fad6148", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "MONITOR EQUITY, FAIRNESS, AND IMPACT ACROSS USE CASES", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Adjust or discontinue tools when inequities, inaccuracies, or harms are identified.", "span": {"start": 2199, "end": 2282, "sha256": "8f3b1882d14d967f54d44d86c775502a177abcfca53515ac3373f1b84b0b40dc", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "MONITOR EQUITY, FAIRNESS, AND IMPACT ACROSS USE CASES", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": "when inequities, inaccuracies, or harms are identified"}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Incorporate AI monitoring into existing district equity audits and improvement cycles.", "span": {"start": 2284, "end": 2370, "sha256": "6b0bc0fc4d686100ed94acf6c3fdde53eb9b487de281b713d826c9af008ff182", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "MONITOR EQUITY, FAIRNESS, AND IMPACT ACROSS USE CASES", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Enforce data minimization, access controls, encryption, and secure integration practices.", "span": {"start": 2431, "end": 2520, "sha256": "103b66a38545b61973ff9334b59a774a3d99eb8c7e14eba16d6dcf50fe568b55", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "PROTECT STUDENT DATA AND ENSURE ROBUST SECURITY PRACTICES", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Ensure contracts include strict data-use limitations, deletion requirements, and clear incident response obligations.", "span": {"start": 2522, "end": 2639, "sha256": "5dc97f1d9885852d1daf95a590e03242662b5e4c9fd6d80d39540ddf116b9f87", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "PROTECT STUDENT DATA AND ENSURE ROBUST SECURITY PRACTICES", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Train staff on responsible data entry into AI systems and prohibit entering sensitive PII into unauthorized tools.", "span": {"start": 2641, "end": 2755, "sha256": "71fd69faa2f267566fa2944770728e6df3b2ddd9c390041f96924e6eef715d82", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "PROTECT STUDENT DATA AND ENSURE ROBUST SECURITY PRACTICES", "page": 1, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
{"unit": "msde-local-level-responsibilities#u000", "extractor": {"provider": "claude_cli", "model_role": "extractor", "model": "claude-sonnet-5-5", "prompt_sha256": "4feb9a353c605aab613cd4d7c4d52d02429f4661f37332bd79ea029467098cd6", "prompt_version": "extract_v1"}, "status": "grounded", "item": "obligation", "text": "Maintain cybersecurity safeguards appropriate to AI-related risks.", "span": {"start": 2832, "end": 2898, "sha256": "2bae19dc665c288ddf98ba7fa52912ee26b4c69ca32436a0aa3c7f1317f20361", "parsed_sha256": "2d7db403d7594987809f0ac15988b0696aad2511caaf31e54b437cf257c6e4d0"}, "matches_in_unit": 1, "section_path": "Public Schools: LEA Responsibilities", "page": 2, "force": "obligation", "binds": "Local Education Agencies (LEAs)", "responsible_party_stated": true, "mechanism_stated": null}
