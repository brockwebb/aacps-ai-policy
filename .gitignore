.env
.venv/
__pycache__/
corpus/inbox/*
!corpus/inbox/.gitkeep
graphs/*/evidence/*/*.rows.jsonl
graphs/*/work/
*.lock
# AD-039: cc_tasks/ and handoffs/ are TRACKED; only data blobs under them are ignored, by size. Handoffs are secret-scanned before commit (FC-02).
cc_tasks/*.json
cc_tasks/*.jsonl
handoffs/*.json
handoffs/*.jsonl

# The standing dispatcher's runtime state (seldon dispatch adopt, AD-038-R11).
.seldon/DISPATCH_STOP
logs/dispatch/
logs/seldon_dispatch.log
.claude/worktrees/
